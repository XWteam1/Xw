# Local dev: SQLite, zero setup. Production: a Postgres URL from Neon.
DATABASE_URL="file:./dev.db"

# NextAuth-style signed session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Resend (email). Leave blank locally — emails print to the terminal instead
# of sending. Required in production.
RESEND_API_KEY=""
EMAIL_FROM="XW Social <onboarding@resend.dev>"

# The person who approves access requests. Seeded as an approved Admin.
ADMIN_EMAIL=""
ADMIN_NAME=""
